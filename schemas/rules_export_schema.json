          "comment": "Gender-neutral term",
          "created_at": "2023-12-06",
          "updated_at": "2023-12-06 15:39:27.302864",
          "createdby": null
        }
      },
      {
        "model": "rules.trainingsentence",
        "pk": 1,
        "fields": {
          "rule": 1,
          "text": "The chairman announced the decision.",
          "is_advanced": false,
          "comment": null,
          "created_at": "2023-12-06",
          "updated_at": "2023-12-06 15:39:27.302864",
          "createdby": null
        }
      }
    ]
  ]
}
