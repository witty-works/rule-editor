[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Django 5.2 is LTS; 6.0 requires Python 3.12+ (this app runs on python:3.11)
django = ">=5.2.16,<6"
django-debug-toolbar = "*"
django-enum = "*"
django-import-export = "*"
django-ordered-model = "*"
platformshconfig = "*"
gunicorn = "*"
django-environ = "*"
django-admin-rangefilter = "*"
sentry-sdk = {extras = ["django"], version = "*"}
django-more-admin-filters = "*"
requests = "*"
emoji = "*"
django-taggit = "*"
django-autocomplete-light = "*"
# Grappelli 5.0 dropped Python 3.11 support (3.12+ only)
django-grappelli = "<5"
django-computedfields = "*"
django-forms-dynamic = "*"
inflex = "*"
# german-nouns is vendored in rules/vendor/german_nouns/ — see the README there.
# Its wiktionary-de-parser pin held lxml at <5; vendoring drops lxml,
# wiktionary-de-parser and mwparserfromhell from the tree entirely.
beautifulsoup4 = "*"
django-nested-admin = "*"
breame = "*"
openai = "*"
python-dotenv = "*"
json-repair = "*"
pluralizefr = "*"
jsonschema = "*"
tqdm = "*"

[dev-packages]

[requires]
python_version = "3.11"
